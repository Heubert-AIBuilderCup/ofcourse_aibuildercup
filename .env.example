# Copy to .env and fill in. .env is never committed.

# Postgres from docker-compose.yml (bun run db:up). Change the host port in both places if 5433 is taken.
DATABASE_URL=postgres://app:app@localhost:5433/app

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console, OAuth client ID, type Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These addresses become superadmin at their first sign-in; every other role is
# given in the admin.
SUPERADMIN_EMAILS=

# Comma-separated email domains whose accounts get the staff mark at sign-up. An entry ending in
# `.*` also matches one regional label: example.com.* matches example.com and example.com.au.
# Blank: nobody is marked.
STAFF_EMAIL_DOMAINS=

# Development only: lets Playwright and the browser console sign in without Google
# (POST /api/dev-login). Any long random string; the route is a 404 in production.
DEV_LOGIN_SECRET=
